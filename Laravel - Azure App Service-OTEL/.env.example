APP_NAME="Little Poll"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Flash session state keeps a submitted pick until the next page refresh.
SESSION_DRIVER=file
CACHE_STORE=array
QUEUE_CONNECTION=sync

# Optional OpenTelemetry OTLP/HTTP export; unset to disable request tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=little-poll
